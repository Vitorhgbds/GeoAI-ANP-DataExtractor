--SELECT COUNT(distinct well_id) FROM merged WHERE LOWER(path) LIKE &quot;%perfil%convencional%&quot;;</sql><sql name="SQL 4*">select count(distinct well_id) from wells;</sql><current_tab id="2"/></tab_sql></sqlb_project>
