<?xml version="1.0" encoding="UTF-8"?><sqlb_project><db path="download.db" readonly="0" foreign_keys="1" case_sensitive_like="0" temp_store="0" wal_autocheckpoint="1000" synchronous="2"/><attached/><window><main_tabs open="structure browser pragmas query" current="3"/></window><tab_structure><column_width id="0" width="300"/><column_width id="1" width="0"/><column_width id="2" width="100"/><column_width id="3" width="1101"/><column_width id="4" width="0"/><expanded_item id="0" parent="1"/><expanded_item id="1" parent="1"/><expanded_item id="2" parent="1"/><expanded_item id="3" parent="1"/></tab_structure><tab_browse><table title="downloads" custom_title="0" dock_id="1" table="4,9:maindownloads"/><dock_state state="000000ff00000000fd00000001000000020000057b00000371fc0100000001fb000000160064006f0063006b00420072006f007700730065003101000000000000057b0000013f00ffffff0000026f0000000000000004000000040000000800000008fc00000000"/><default_encoding codec=""/><browse_table_settings><table schema="main" name="downloads" show_row_id="0" encoding="" plot_x_axis="" unlock_view_pk="_rowid_" freeze_columns="0"><sort/><column_widths><column index="1" value="1119"/><column index="2" value="821"/><column index="3" value="300"/><column index="4" value="62"/><column index="5" value="300"/><column index="6" value="300"/><column index="7" value="234"/><column index="8" value="156"/></column_widths><filter_values/><conditional_formats/><row_id_formats/><display_formats/><hidden_columns/><plot_y_axes/><global_filter/></table></browse_table_settings></tab_browse><tab_sql><sql name="SQL 1*">WITH RECURSIVE
  input AS (
    SELECT 
      path,
      substr(path, 1, instr(path, 'Perfil') - 2) AS pre_perfil
    FROM downloads
    WHERE instr(path, 'Perfil') &gt; 0
  ),
  reversed(path, str, rev, n) AS (
    SELECT 
      path,
      pre_perfil,
      '', 
      length(pre_perfil)
    FROM input
    UNION ALL
    SELECT
      path,
      str,
      rev || substr(str, n, 1),
      n - 1
    FROM reversed
    WHERE n &gt; 0
  ),
  last_backslash_pos AS (
    SELECT 
      path,
      str,
      length(str) - instr(rev, '\') + 2 AS start_pos
    FROM reversed
    WHERE n = 0
  ),
  extracted AS (
    SELECT
      path,
      substr(str, start_pos) AS well_id
    FROM last_backslash_pos
  )
UPDATE downloads
SET well_id = (
  SELECT well_id
  FROM extracted
  WHERE extracted.path = downloads.path
)
WHERE path IN (SELECT path FROM extracted);</sql><sql name="SQL 2*">ALTER TABLE downloads ADD COLUMN well_id TEXT;
--SELECT * FROM downloads;
</sql><sql name="SQL 3*">WITH wellsInfo AS (
	SELECT DISTINCT
		well_id,
		MAX(CASE WHEN LOWER(path) LIKE &quot;%perfil%composto%&quot; THEN 1 ELSE 0 END) AS has_composite,
		MAX(CASE WHEN LOWER(path) LIKE &quot;%perfil%convencional%&quot; THEN 1 ELSE 0 END) AS has_conventional
	FROM merged
	WHERE well_id IS NOT NULL
	GROUP BY well_id
) SELECT 
	SUM(CASE WHEN has_composite IS 1 AND has_conventional IS 0 THEN 1 ELSE 0 END) AS total_only_composite,
	SUM(CASE WHEN has_composite IS 0 AND has_conventional IS 1 THEN 1 ELSE 0 END) AS total_only_conventional,
	SUM(CASE WHEN has_composite IS 1 AND has_conventional IS 1 THEN 1 ELSE 0 END) AS total_both,
	SUM(CASE WHEN has_composite IS 1 OR has_conventional IS 1 THEN 1 ELSE 0 END) AS total_at_least_one,
	SUM(CASE WHEN has_composite IS 0 AND has_conventional IS 0 THEN 1 ELSE 0 END) AS total_none
	FROM wellsInfo;
-- 4512
